# Copy this file to .env and fill in your own values.

# App
APP_NAME=courier-agent-demo
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite
DATABASE_PATH=data/courier_agent.db

# LLM model
# Default mode uses OpenAI-compatible Chat Completions endpoints.
COURIER_AGENT_PROVIDER=openai-compatible
COURIER_AGENT_MODEL=gpt-4o-mini

# OpenAI-compatible credentials.
# For official OpenAI, keep OPENAI_BASE_URL as https://api.openai.com/v1.
# For compatible gateways, replace it with your provider endpoint.
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Heartbeat and business rules
HEARTBEAT_INTERVAL_SECONDS=10
LOW_BATTERY_THRESHOLD=15

# Real-world integrations (article 02). Leave unset to use log-only mode:
# the agent records what it would have sent but makes no network call.
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
# CUSTOMER_CONTACT_WEBHOOK_URL=https://ntfy.sh/your-private-topic
ROUTING_BASE_URL=https://router.project-osrm.org
INTEGRATION_TIMEOUT_SECONDS=5
