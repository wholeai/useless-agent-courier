# Copy this file to .env and fill in your own values.

# App
APP_NAME=courier-agent-demo
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite
DATABASE_PATH=data/courier_agent.db

# LLM model
# Default mode uses OpenAI-compatible Chat Completions endpoints.
COURIER_AGENT_PROVIDER=openai-compatible
COURIER_AGENT_MODEL=gpt-4o-mini

# OpenAI-compatible credentials.
# For official OpenAI, keep OPENAI_BASE_URL as https://api.openai.com/v1.
# For compatible gateways, replace it with your provider endpoint.
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Heartbeat and business rules
HEARTBEAT_INTERVAL_SECONDS=10
LOW_BATTERY_THRESHOLD=15
